# Downloaded artifacts
*.jar
!/lib/.gitkeep

# Decompiled and extracted game code
/src/
/garlic-src/
/garlic-class-tests*/
/classes/
/garlic-classes/
/classes-original/

# Build outputs
/launcher-classes/
/stubs-classes/
/frames/
/frames-test/

# Loose .class artifacts at repo root (decompilation experiments)
/*.class
/scripts/Verify.class
/asm-tools/

# Generated analysis and run output
/traces/
/.work/
/reductions/
/*.json
/*.txt
/javac.*.args

# Local caches and editor files
/.cache/
__pycache__/
/.idea/
/.vscode/
*~

# Server/client run output produced next to the checkout
/*.log
/*.log.*
/main_file_cache.*
/random.dat
/hs_err_pid*.log
/.attach_pid*

# Live server state -- accounts.json holds credentials, never commit it
/apps/server/accounts.json
/apps/server/achievements.json
/apps/server/hiscores.json
/apps/server/progress.json

# Compiled probe classes; ParityProbe.java is the source of truth
/tools/oracle/**/*.class

# Instrumentation build intermediates (extracted game classes)
/tools/instr/work/
/tools/instr/work-result/

# Generated golden tables (~21MB); regenerate with tools/oracle ParityProbe
/apps/server/tests/fixtures/*.tsv
# ...except the clear-settle table, which is only ~50KB. It pins a rule that
# has now been measured wrong twice, so it is worth carrying in the repo:
# ignored, the test silently skips and the pinning is illusory on a fresh
# checkout. Regenerate with tools/oracle/ClearProbe settle.
!/apps/server/tests/fixtures/golden-clear-settle.tsv
